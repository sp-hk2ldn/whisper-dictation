// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = WhisperDictation
PRODUCT_DISPLAY_NAME = Whisper Dictation
WHISPER_BUNDLE_IDENTIFIER = io.github.sp-hk2ldn.WhisperDictation
PRODUCT_BUNDLE_IDENTIFIER = $(WHISPER_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSMicrophoneUsageDescription = Whisper Dictation records only while you hold its dictation hotkey and transcribes the audio locally.

// Required for Accessibility and global input insertion into other applications.
ENABLE_APP_SANDBOX = NO

// Silence the obsolete headermap warning emitted by current Xcode.
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/WhisperDictation.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/WhisperDictation.entitlements

// ==========================================
// Local overrides
// ==========================================
// Copy Config/Local.xcconfig.example to Config/Local.xcconfig (ignored by git)
// to set your own bundle identifier and signing team.
#include? "Local.xcconfig"
